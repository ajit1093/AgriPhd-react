{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=localhost\\SQLEXPRESS;Initial Catalog=2025_AgriPHD_Live;Integrated Security=True;Connection Timeout=30;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "SecretKey": "DEV_ONLY_REPLACE_IN_PRODUCTION_SECRET_KEY_MIN_32_CHARS",
    "Issuer": "AgriPhd.Api",
    "Audience": "AgriPhd.Web",
    "AccessTokenExpiryMinutes": 20,
    "RefreshTokenExpiryHours": 8
  },
  "AzureBlobStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "agri-phd-docs"
  },
  "Razorpay": {
    "Key": "DEV_KEY_PLACEHOLDER",
    "SecretKey": "DEV_SECRET_PLACEHOLDER"
  },
  "SendGrid": {
    "ApiKey": "DEV_SENDGRID_KEY_PLACEHOLDER"
  },
  "Msg91": {
    "AuthKey": "DEV_MSG91_KEY_PLACEHOLDER",
    "SenderId": "AGRPHD"
  },
  "AppSettings": {
    "DevEnvironment": "YES",
    "IsCaptchaVerificationRequired": "N",
    "CheckDuplicateMobileNo": "Y",
    "CheckDuplicateEMailID": "Y",
    "IsMultipleLoginAllowed": false,
    "WebsiteHeader": "AgriPHD Online Admissions Portal 2026-27",
    "ReactAppOrigin": "http://localhost:5173"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
